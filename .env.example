# .env.example: copy to .env and fill in JWT_SECRET_KEY.
# Service addresses (service names on the Compose network)
OLLAMA_URL=http://ollama:11434
API_URL=http://backend:8000

# Model and retrieval
MODEL_NAME=llama3.2:1b
CHROMA_PATH=/app/chroma_data
COLLECTION_NAME=animals
DOCS_DIRECTORY=/app/docs
MAX_RESULTS=3
LOW_CONFIDENCE_THRESHOLD=0.7
HIGH_CONFIDENCE_THRESHOLD=0.3
MEDIUM_CONFIDENCE_THRESHOLD=0.6

# Database (four slashes = absolute path inside the container)
DATABASE_URL=sqlite:////app/data/wildwise.db

# JWT login (put a long random secret in .env only)
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DEBUG=true
PYTHONUNBUFFERED=1

AUTO_INGEST=true